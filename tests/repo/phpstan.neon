# Static analysis of the site's PHP (see AGENTS.md). Run from the repo folder:  php phpstan.phar analyse -c tests/repo/phpstan.neon
parameters:
    level: 3   # 1.53.1: raised from 1 (no finding at 3)
    paths:
        - ../../src
    bootstrapFiles:
        - ../lib/phpstan-bootstrap.php
    ignoreErrors:
        # every page's api.php has its own small out() helper; PHPStan reads all pages as one program and mixes them up
        - '#^Function out invoked with \d+ parameters?, \d+ required\.$#'
