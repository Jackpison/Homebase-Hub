#!/bin/bash
# YunoHost removes the site's folder by itself. Your data folder stays unless you remove the app with --purge.
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Removing the PHP and nginx settings..."
ynh_config_remove_nginx
ynh_safe_rm "/etc/nginx/conf.d/homebasehub-maps.conf"
ynh_systemctl --service=nginx --action=reload
ynh_config_remove_phpfpm

ynh_script_progression "Removal of $app completed"
