DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
  # Not for PHP files: api.php sends its own, and the same header twice (or two values) can make a browser ignore it.
  <FilesMatch "^(?!.*\.php$)">
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
  <FilesMatch "\.html$">
    # Pre-load a page when you hover over its link in the bar (the rules are in hub/core/assets/speculation-rules.json).
    Header set Speculation-Rules "\"../hub/core/assets/speculation-rules.json\""
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
