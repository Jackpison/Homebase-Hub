# The Home characters: scripts, styles and models (.json), all safe for a browser to open.
# Home asks for them with ?v=<file time>, so a changed file always has a new address and browsers may keep them.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=[^&]+
  RewriteRule \.(css|js|json)$ - [E=HUB_VERSIONED:1]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|json)$">
    Header set Cache-Control "no-cache" env=!HUB_VERSIONED
    Header set Cache-Control "public, max-age=31536000, immutable" env=HUB_VERSIONED
  </FilesMatch>
</IfModule>
