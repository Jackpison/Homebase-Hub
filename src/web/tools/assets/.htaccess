# An address with ?v=<fingerprint> never changes its content: browsers keep it for a year. Everything else is re-checked.
# No ETag: with compression on, many servers add "-gzip" to it and then never answer "not modified", so the big files would be sent again.
# Without it browsers check Last-Modified, which works with compression (a quick 304 when the file is unchanged).
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=[^&]+
  RewriteRule \.(css|js)$ - [E=HUB_VERSIONED:1]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=HUB_VERSIONED
  </FilesMatch>
</IfModule>
